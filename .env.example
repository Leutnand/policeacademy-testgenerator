DJANGO_SECRET_KEY=bitte-durch-langen-zufaelligen-wert-ersetzen
DJANGO_ALLOWED_HOSTS=example.com
CSRF_TRUSTED_ORIGINS=https://example.com
PORT=8000

# Optional: PostgreSQL statt SQLite, z. B. postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Fehlversuch-Limits
OTP_MAX_FAILED_ATTEMPTS=5
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_MINUTES=15

# Audit-Log: all = jeder Zugriff, changes = nur Änderungen und Fehler
AUDIT_LOG_REQUESTS=all
AUDIT_LOG_RETENTION_DAYS=180
AUDIT_LOG_MAX_ENTRIES=50000

# Bei mehreren Replicas nur in einer Instanz aktivieren
RUN_MIGRATIONS=True
RUN_COLLECTSTATIC=True
